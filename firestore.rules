rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId']) &&
        data.keys().hasOnly(['id', 'name', 'description', 'ownerId', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 256 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1024)) &&
        data.ownerId is string && data.ownerId == request.auth.uid &&
        (!('status' in data) || (data.status is string && data.status.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'projectId', 'content', 'sender']) &&
        data.keys().hasOnly(['id', 'projectId', 'content', 'sender', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.content is string && data.content.size() <= 5000 &&
        data.sender is string && data.sender.size() <= 64 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(request.resource.data);
      allow update: if isSignedIn() && isValidId(projectId) && isValidProject(request.resource.data) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isValidId(projectId) && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(projectId) && isValidId(messageId) &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid &&
          isValidMessage(request.resource.data) &&
          request.resource.data.projectId == projectId;
        allow update: if isSignedIn() && isValidId(projectId) && isValidId(messageId) &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid &&
          isValidMessage(request.resource.data);
        allow delete: if isSignedIn() && isValidId(projectId) && isValidId(messageId) &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
